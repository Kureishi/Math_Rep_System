# One line-ending convention for everyone. Without this, Git for Windows (autocrlf) and tools that rewrite files
# (merge tools, editors, zip round-trips) flip files between CRLF and LF, and every flipped file then shows as
# "entirely changed" -- which is what turns an ordinary merge into a wall of conflicts.
* text=auto eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.db   binary
*.xlsx binary
*.docx binary
*.pptx binary
*.ipynb text eol=lf

# Windows scripts must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
